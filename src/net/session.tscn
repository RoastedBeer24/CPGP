[gd_scene format=3]

[ext_resource type="Script" path="res://src/net/session.gd" id="1_session"]
[ext_resource type="Script" path="res://src/run/run.gd" id="2_run"]

[sub_resource type="SceneReplicationConfig" id="SceneReplicationConfig_run"]
properties/0/path = NodePath(".:phase")
properties/0/spawn = true
properties/0/replication_mode = 2
properties/1/path = NodePath(".:stage")
properties/1/spawn = true
properties/1/replication_mode = 2
properties/2/path = NodePath(".:reward_round")
properties/2/spawn = true
properties/2/replication_mode = 2
properties/3/path = NodePath(".:run_seed")
properties/3/spawn = true
properties/3/replication_mode = 2

[node name="Session" type="Node"]
script = ExtResource("1_session")

[node name="World" type="Node3D" parent="."]

[node name="Players" type="Node3D" parent="."]

[node name="PlayerSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Players")

[node name="Run" type="Node" parent="."]
script = ExtResource("2_run")

[node name="RunSync" type="MultiplayerSynchronizer" parent="Run"]
replication_config = SubResource("SceneReplicationConfig_run")
